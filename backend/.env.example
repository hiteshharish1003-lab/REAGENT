# Copy to backend/.env. Leave everything blank to stay in demo mode (canned data).

# LLM keys. Gemini and Groq are free (no credit card). Set both: when one hits its daily free quota the app
# automatically continues on the other. Anthropic is pay-as-you-go and, if set, is used instead of both.
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Search (free tier, no card): tavily.com
TAVILY_API_KEY=
